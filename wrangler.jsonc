{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "querixco",
  "compatibility_date": "2026-07-10",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "querix.co",
      "custom_domain": true
    },
    {
      "pattern": "www.querix.co",
      "custom_domain": true
    }
  ]
}
